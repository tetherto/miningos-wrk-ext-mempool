{
  "name": "@tetherto/miningos-wrk-ext-mempool",
  "version": "1.1.0",
  "description": "MiningOS Mempool Worker",
  "keywords": [
    "tether"
  ],
  "author": "Tether",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tetherto/miningos-wrk-ext-mempool.git"
  },
  "homepage": "https://github.com/tetherto/miningos-wrk-ext-mempool#readme",
  "bugs": {
    "url": "https://github.com/tetherto/miningos-wrk-ext-mempool/issues"
  },  
  "engines": {
    "node": ">=24"
  },
  "files": [
    "worker.js",
    "workers/"
  ],
  "main": "worker.js",  
  "type": "commonjs",
  "bin": {
    "miningos-wrk-ext-mempool": "worker.js"
  },  
  "scripts": {
    "lint": "standard",
    "lint:fix": "standard --fix",
    "test": "npm run lint && npm run test:unit",
    "test:unit": "brittle tests/unit/*.js",
    "test:integration": "brittle tests/integration/*.js",
    "test:coverage": "brittle --coverage tests/unit/*.js tests/integration/*.js",
    "dev": "node worker.js --wtype wrk-ext-mempool-rack --env development --rack rack-1"
  },
  "dependencies": {
    "@bitfinex/bfx-svc-boot-js": "1.3.1",
    "@bitfinex/bfx-facs-http": "^1.1.3",
    "@bitfinex/bfx-facs-interval": "^1.0.0",
    "@bitfinex/lib-js-util-base": "^2.1.0",
    "@tetherto/hp-svc-facs-store": "^1.0.1",
    "@tetherto/tether-wrk-base": "^2.0.1",
    "async": "3.2.6",
    "mingo": "6.5.6"
  },
  "devDependencies": {
    "brittle": "3.16.3",
    "standard": "17.1.2"
  }
}
